{
  "manifest_version": 3,
  "name": "ChatGPT Page Context",
  "version": "1.0",
  "description": "Share the current page with ChatGPT and have a conversation.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
